{
  "name": "mic-android",
  "version": "0.3.0",
  "private": true,
  "description": "MIC — Monde Interconnecté : application Android (Capacitor)",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && cap sync android",
    "build:apk": "node scripts/build-www.mjs && cap sync android && cd android && ./gradlew assembleRelease",
    "icons": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "sql.js": "^1.14.2"
  }
}
